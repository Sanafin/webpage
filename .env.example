# Klaviyo private API key (Workers secret). Required by /api/request-deck and /api/request-access.
KLAVIYO_PRIVATE_API_KEY=
# Klaviyo list for product updates (marketing consent). Required by /api/request-access only.
KLAVIYO_LIST_ID=
# Public site URL used for canonical links, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://sanafin.tech
# Optional: cookieless analytics. Leave empty to ship no analytics script.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
