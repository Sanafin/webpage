# Plunk (open source, https://github.com/useplunk/plunk). Required by both form routes.
PLUNK_SECRET_KEY=
# Self-hosted Plunk only: base URL of your instance's API (default https://api.useplunk.com/v1)
# PLUNK_API_URL=
# Where deck requests are emailed. Required by /api/request-deck.
DECK_NOTIFY_TO=
# Public site URL used for canonical links, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://sanafin.tech
# Optional: cookieless analytics. Leave empty to ship no analytics script.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
