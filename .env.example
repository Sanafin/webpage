# Public site URL used for canonical links, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://sanafin.tech
# Optional: cookieless analytics. Leave empty to ship no analytics script.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Private preview at /app. Passcode visitors type, and the secret that signs the
# session cookie (any long random string). Production values are Worker secrets:
#   wrangler secret put APP_PASSCODE && wrangler secret put APP_SESSION_SECRET
# For `next dev` put throwaway values in .env.local; for `npm run preview` use .dev.vars.
# Note: opennextjs-cloudflare bundles .env* values into the Worker, so never put real
# secrets in .env.local on a machine that deploys.
APP_PASSCODE=
APP_SESSION_SECRET=
